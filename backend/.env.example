# =============================================================
# TEMPLATE DES VARIABLES D'ENVIRONNEMENT — COPIEZ CE FICHIER EN .env
# =============================================================
# Commande : cp .env.example .env    (puis remplissez vos valeurs)

SECRET_KEY=CHANGEZ_MOI_PAR_UNE_CLE_SECRETE_UNIQUE

DEBUG=True

# ---------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=zrida_db
DB_USER=postgres
DB_PASSWORD=VOTRE_MOT_DE_PASSE_POSTGRES
DB_HOST=localhost
DB_PORT=5432

# Pour GCP Cloud SQL :
# DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ---------------------------------------------------------------
# HOSTS AUTORISÉS
# ---------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1,inforeussite.online,www.inforeussite.online

# ---------------------------------------------------------------
# EMAIL (SMTP avec votre nom de domaine ou service dédié)
# ---------------------------------------------------------------
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=contact@inforeussite.online
EMAIL_HOST_PASSWORD=VOTRE_MOT_DE_PASSE_EMAIL_HOSTINGER
DEFAULT_FROM_EMAIL=Info Réussit <contact@inforeussite.online>
